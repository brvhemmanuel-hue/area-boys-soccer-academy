# Neon connection string (Neon dashboard > Connect)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Password the admin types to sign in
ADMIN_PASSWORD=change-me
# Long random string used to sign login tokens (e.g. run: openssl rand -hex 32)
AUTH_SECRET=change-me-too
